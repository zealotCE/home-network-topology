{
  "name": "@home-network-topology/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "node -e \"console.log('backend: no dedicated lint rules yet')\"",
    "test": "NODE_ENV=test tsx --test src/*.test.ts src/**/*.test.ts",
    "typecheck": "pnpm --filter @home-network-topology/shared build && tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@home-network-topology/shared": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "fastify": "^5.2.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
