{
  "name": "home-network-topology",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10"
  },
  "volta": {
    "node": "22.14.0",
    "pnpm": "10.18.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @home-network-topology/frontend --filter @home-network-topology/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @home-network-topology/shared build && pnpm -r typecheck"
  }
}
